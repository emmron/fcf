# Copy to .env.local for local development, and add the same keys in Vercel → Project → Settings → Environment Variables.

# Public URL of the site (used for canonical URLs, sitemap and social cards).
NEXT_PUBLIC_SITE_URL=https://www.fcpt.com.au

# Optional: an external online-booking page (e.g. Wix Bookings on a subdomain, Cal.com, Fresha).
# Leave empty and every "Book" button goes to the enquiry form on /contact instead.
NEXT_PUBLIC_BOOKING_URL=

# Enquiry form email delivery via Resend (https://resend.com). Without a key the form shows the phone/email instead.
RESEND_API_KEY=
# Where enquiries are sent (defaults to hello@fcpt.com.au).
CONTACT_TO_EMAIL=hello@fcpt.com.au
# Sender address. Must be on a domain verified in Resend, e.g. "FC Fitness website <website@fcpt.com.au>".
CONTACT_FROM_EMAIL=
